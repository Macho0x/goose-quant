fn western(y: i32) -> i32 {
    if y < 1901 || y > 2199 { return 0; }
    return WESTERN[y - 1901];
}

fn orthodox(y: i32) -> i32 {
    if y < 1901 || y > 2199 { return 0; }
    return ORTHODOX[y - 1901];
}
