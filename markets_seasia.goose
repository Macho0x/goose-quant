// Southeast Asian market holiday rules. A market is an i32.
// A day is a business day when is_business_day returns true.
// INDIA_NSE 180: India::NseImpl, market NSE
// INDONESIA_BEJ 181: Indonesia::BejImpl, market BEJ
// INDONESIA_JSX 182: Indonesia::BejImpl, market JSX
// INDONESIA_IDX 183: Indonesia::BejImpl, market IDX
// MALAYSIA_KLSE 184: Malaysia::KlseImpl, market KLSE
// PHILIPPINES_PSE 185: Philippines::PseImpl, market PSE
// SINGAPORE_SGX 186: Singapore::SgxImpl, market SGX
// THAILAND 187: Thailand::SetImpl
// Western Easter Monday is easter::western(year), a day-of-year.
// Weekend is Saturday and Sunday.

import date;
import easter;

namespace markets_seasia;

const INDIA_NSE: i32 = 180;
const INDONESIA_BEJ: i32 = 181;
const INDONESIA_JSX: i32 = 182;
const INDONESIA_IDX: i32 = 183;
const MALAYSIA_KLSE: i32 = 184;
const PHILIPPINES_PSE: i32 = 185;
const SINGAPORE_SGX: i32 = 186;
const THAILAND: i32 = 187;

fn known(kind: i32) -> bool {
    return kind >= INDIA_NSE && kind <= THAILAND;
}

fn is_business_day(kind: i32, d: date::Date) -> bool {
    if kind == INDIA_NSE { return india(d); }
    if kind == INDONESIA_BEJ || kind == INDONESIA_JSX || kind == INDONESIA_IDX { return indonesia(d); }
    if kind == MALAYSIA_KLSE { return malaysia(d); }
    if kind == PHILIPPINES_PSE { return philippines(d); }
    if kind == SINGAPORE_SGX { return singapore(d); }
    if kind == THAILAND { return thailand(d); }
    return true;
}

fn weekend(w: i32) -> bool {
    return w == date::SATURDAY || w == date::SUNDAY;
}

fn on_list(days: i32[:], y: i32, m: i32, day: i32) -> bool {
    let key: i32 = y * 10000 + m * 100 + day;
    var i: i64 = 0;
    while i < days.len {
        if days[i] == key { return true; }
        i += 1;
    }
    return false;
}

fn india(d: date::Date) -> bool {
    let w = date::weekday(d);
    let day = date::day_of_month(d);
    let m = date::month(d);
    let y = date::year(d);
    let doy = date::day_of_year(d);
    let em = easter::western(y);
    if weekend(w) { return false; }
    if day == 26 && m == date::JANUARY { return false; }
    if doy == em - 3 { return false; }
    if day == 14 && m == date::APRIL { return false; }
    if day == 1 && m == date::MAY { return false; }
    if day == 15 && m == date::AUGUST { return false; }
    if day == 2 && m == date::OCTOBER { return false; }
    if day == 25 && m == date::DECEMBER { return false; }
    if on_list(INDIA_TAB, y, m, day) { return false; }
    return true;
}

fn indonesia(d: date::Date) -> bool {
    let w = date::weekday(d);
    let day = date::day_of_month(d);
    let m = date::month(d);
    let y = date::year(d);
    let doy = date::day_of_year(d);
    let em = easter::western(y);
    if weekend(w) { return false; }
    if day == 1 && m == date::JANUARY { return false; }
    if doy == em - 3 { return false; }
    if doy == em + 38 { return false; }
    if day == 1 && m == date::MAY && y >= 2014 { return false; }
    if day == 1 && m == date::JUNE && y >= 2017 { return false; }
    if day == 17 && m == date::AUGUST { return false; }
    if day == 25 && m == date::DECEMBER { return false; }
    if on_list(INDONESIA_TAB, y, m, day) { return false; }
    return true;
}

fn malaysia(d: date::Date) -> bool {
    let w = date::weekday(d);
    let day = date::day_of_month(d);
    let m = date::month(d);
    let y = date::year(d);
    if weekend(w) { return false; }
    if day == 1 && m == date::JANUARY { return false; }
    if day == 1 && m == date::FEBRUARY { return false; }
    if day == 1 && m == date::MAY { return false; }
    if day == 31 && m == date::AUGUST { return false; }
    if day == 16 && m == date::SEPTEMBER && y >= 2010 { return false; }
    if day == 25 && m == date::DECEMBER { return false; }
    if on_list(MALAYSIA_TAB, y, m, day) { return false; }
    return true;
}

fn philippines(d: date::Date) -> bool {
    let w = date::weekday(d);
    let day = date::day_of_month(d);
    let m = date::month(d);
    let y = date::year(d);
    let doy = date::day_of_year(d);
    let em = easter::western(y);
    if weekend(w) { return false; }
    if on_list(PHILIPPINES_OFF, y, m, day) { return true; }
    if day == 1 && m == date::JANUARY { return false; }
    if doy == em - 4 { return false; }
    if doy == em - 3 { return false; }
    if day == 9 && m == date::APRIL { return false; }
    if day == 1 && m == date::MAY { return false; }
    if day == 12 && m == date::JUNE { return false; }
    if day == 21 && m == date::AUGUST && y >= 2004 { return false; }
    if day >= 25 && w == date::MONDAY && m == date::AUGUST { return false; }
    if day == 1 && m == date::NOVEMBER { return false; }
    if day == 30 && m == date::NOVEMBER { return false; }
    if day == 8 && m == date::DECEMBER && y >= 2018 { return false; }
    if day == 25 && m == date::DECEMBER { return false; }
    if day == 30 && m == date::DECEMBER { return false; }
    if day == 31 && m == date::DECEMBER { return false; }
    if on_list(PHILIPPINES_TAB, y, m, day) { return false; }
    return true;
}

fn singapore(d: date::Date) -> bool {
    let w = date::weekday(d);
    let day = date::day_of_month(d);
    let m = date::month(d);
    let y = date::year(d);
    let doy = date::day_of_year(d);
    let em = easter::western(y);
    if weekend(w) { return false; }
    if (day == 1 || (day == 2 && w == date::MONDAY)) && m == date::JANUARY { return false; }
    if doy == em - 3 { return false; }
    if day == 1 && m == date::MAY { return false; }
    if (day == 9 || (day == 10 && w == date::MONDAY)) && m == date::AUGUST { return false; }
    if day == 25 && m == date::DECEMBER { return false; }
    if on_list(SINGAPORE_TAB, y, m, day) { return false; }
    return true;
}

fn thailand(d: date::Date) -> bool {
    let w = date::weekday(d);
    let day = date::day_of_month(d);
    let m = date::month(d);
    let y = date::year(d);
    if weekend(w) { return false; }
    if (day == 1 || (day == 3 && w == date::MONDAY)) && m == date::JANUARY { return false; }
    if (day == 6 || ((day == 7 || day == 8) && w == date::MONDAY)) && m == date::APRIL { return false; }
    if (day == 13 || day == 14 || day == 15) && m == date::APRIL && y != 2020 { return false; }
    if day == 16 && (w == date::MONDAY || w == date::TUESDAY) && m == date::APRIL && y != 2020 { return false; }
    if (day == 1 || ((day == 2 || day == 3) && w == date::MONDAY)) && m == date::MAY { return false; }
    if (day == 4 || ((day == 5 || day == 6) && w == date::MONDAY)) && m == date::MAY && y >= 2019 { return false; }
    if (day == 3 || ((day == 4 || day == 5) && w == date::MONDAY)) && m == date::JUNE && y >= 2019 { return false; }
    if (day == 28 || ((day == 29 || day == 30) && w == date::MONDAY)) && m == date::JULY && y >= 2017 { return false; }
    if (day == 12 || ((day == 13 || day == 14) && w == date::MONDAY)) && m == date::AUGUST { return false; }
    if (day == 13 || ((day == 14 || day == 15) && w == date::MONDAY)) && m == date::OCTOBER && y >= 2017 { return false; }
    if (day == 23 || ((day == 24 || day == 25) && w == date::MONDAY)) && m == date::OCTOBER && y != 2021 { return false; }
    if (day == 5 || ((day == 6 || day == 7) && w == date::MONDAY)) && m == date::DECEMBER { return false; }
    if (day == 10 || ((day == 11 || day == 12) && w == date::MONDAY)) && m == date::DECEMBER { return false; }
    if (day == 31 && m == date::DECEMBER) || (day == 2 && w == date::MONDAY && m == date::JANUARY && y != 2024) { return false; }
    if on_list(THAILAND_TAB, y, m, day) { return false; }
    return true;
}

