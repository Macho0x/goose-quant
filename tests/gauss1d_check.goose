import os;
import quant from "..";
import quant.gauss1d;

fn fail(msg: u8[:]) {
    write_stdout(msg);
    write_stdout("\n");
    exit(1);
}

fn check(r: f64, a: f64, sigma: f64, b: f64, eta: f64, rho: f64, t: f64, maturity: f64, x: f64, y: f64, want: f64) {
    let px, ok = gauss1d::discount_bond(r, a, sigma, b, eta, rho, t, maturity, x, y);
    if !ok { fail("bond"); }
    var rel = px / want - 1.0;
    if rel < 0.0 { rel = -rel; }
    if rel > 1.0e-14 { fail("expected"); }
}

fn ::main() {
    // testG2DiscountBondForSmallMeanReversion. Relative tolerance 1e-14.
    check(0.03, 1e-9, 0.01, 0.1, 0.005, -0.5, 1.0, 5.0, 0.01, -0.01, 0.88003659072582035);
    check(0.03, 1e-8, 0.01, 0.1, 0.005, -0.5, 1.0, 5.0, 0.01, -0.01, 0.88003659138856715);
    check(0.03, 1e-7, 0.01, 0.1, 0.005, -0.5, 1.0, 5.0, 0.01, -0.01, 0.88003659801603423);
    check(0.03, 1e-6, 0.01, 0.1, 0.005, -0.5, 1.0, 5.0, 0.01, -0.01, 0.88003666429061573);
    check(0.03, 1e-5, 0.01, 0.1, 0.005, -0.5, 1.0, 5.0, 0.01, -0.01, 0.88003732702749102);
    check(0.03, 0.0001, 0.01, 0.1, 0.005, -0.5, 1.0, 5.0, 0.01, -0.01, 0.88004395350237115);
    check(0.03, 0.001, 0.01, 0.1, 0.005, -0.5, 1.0, 5.0, 0.01, -0.01, 0.88011012895729353);
    check(0.03, 0.1, 0.01, 1e-9, 0.005, -0.5, 1.0, 5.0, 0.01, -0.01, 0.89274066161481982);
    check(0.03, 0.1, 0.01, 1e-7, 0.005, -0.5, 1.0, 5.0, 0.01, -0.01, 0.89274065456434843);
    check(0.03, 0.1, 0.01, 1e-5, 0.005, -0.5, 1.0, 5.0, 0.01, -0.01, 0.89273994952677022);
    check(0.03, 0.1, 0.01, 0.001, 0.005, -0.5, 1.0, 5.0, 0.01, -0.01, 0.89266954128089552);
    check(0.03, 1e-7, 0.01, 2e-7, 0.005, -0.5, 1.0, 5.0, 0.01, -0.01, 0.88625548898935952);
    check(0.03, 1e-6, 0.01, 1e-6, 0.005, -0.5, 1.0, 5.0, 0.01, -0.01, 0.8862554988312159);
    check(0.03, 1e-5, 0.01, 0.001, 0.005, -0.5, 1.0, 5.0, 0.01, -0.01, 0.88618543097653418);
    check(0.03, 0.2, 0.01, 0.3, 0.005, -0.5, 1.0, 5.0, 0.01, -0.01, 0.88288328570041449);
    check(0.03, 0.4, 0.01, 0.1, 0.005, -0.5, 1.0, 5.0, 0.01, -0.01, 0.89837482145762172);
    check(0.03, 0.5, 0.01, 0.125, 0.005, -0.5, 1.0, 5.0, 0.01, -0.01, 0.899459669703478);
    check(0.03, 0.45, 0.01, 0.04, 0.005, -0.5, 1.0, 5.0, 0.01, -0.01, 0.90323235067173138);
    check(0.03, 1.0, 0.01, 0.03, 0.005, -0.5, 1.0, 5.0, 0.01, -0.01, 0.91184613030830664);
    check(0.03, 3.0, 0.01, 5.0, 0.005, -0.5, 1.0, 5.0, 0.01, -0.01, 0.88573682792113109);
    check(0.05, 1e-6, 0.02, 0.05, 0.01, 0.8, 0.5, 10.0, -0.02, 0.015, 0.6600529015892483);
    check(0.05, 0.03, 0.02, 1e-7, 0.01, -0.9, 2.0, 30.0, 0.0, 0.0, 0.23888590049897576);
    write_stdout("gauss1d ok\n");
}
