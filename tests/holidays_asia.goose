    20210212, 20220201, 20230123, 20250127, 20260216,
];

fn ::main() {
    if !markets_asia::known(markets_asia::CHINA_SSE) { fail("known sse"); }
    if !markets_asia::known(markets_asia::CHINA_IB) { fail("known ib"); }
    if !markets_asia::known(markets_asia::HKEX) { fail("known hk"); }
    if !markets_asia::known(markets_asia::JAPAN) { fail("known japan"); }
    if !markets_asia::known(markets_asia::KR_SETTLEMENT) { fail("known kr"); }
    if !markets_asia::known(markets_asia::KR_KRX) { fail("known krx"); }
    if !markets_asia::known(markets_asia::TSEC) { fail("known tw"); }
    if markets_asia::known(149) || markets_asia::known(180) { fail("unknown kind"); }
    if !markets_asia::is_business_day(149, ymd(1, 1, 2024)) { fail("unknown day"); }

    check_holidays(markets_asia::CHINA_SSE, ymd(1, 1, 2014), ymd(31, 12, 2026), SSE_HOL, "china sse");
    check_weekends(markets_asia::CHINA_IB, ymd(1, 1, 2014), ymd(31, 12, 2026), IB_WEEKEND);
    check_holidays(markets_asia::HKEX, ymd(1, 1, 2026), ymd(31, 12, 2026), HK_2026, "hong kong");
    each_holiday(markets_asia::HKEX, HK_SPOT, "hong kong spot");
    open(markets_asia::HKEX, 2, 1, 2024, "hong kong open");
    check_holidays(markets_asia::KR_SETTLEMENT, ymd(1, 1, 2004), ymd(31, 12, 2050), KR_HOL, "korea settlement");
    check_holidays(markets_asia::KR_KRX, ymd(1, 1, 2004), ymd(31, 12, 2050), KRX_HOL, "korea krx");
    each_holiday(markets_asia::TSEC, TW_SPOT, "taiwan spot");
    open(markets_asia::TSEC, 2, 1, 2024, "taiwan open");

    write_stdout("asia ok\n");
}
