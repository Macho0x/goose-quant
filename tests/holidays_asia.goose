import os;
import quant from "..";
import quant.date;
import quant.markets_asia;

fn fail(msg: u8[:]) {
    write_stdout(msg);
    write_stdout("\n");
    exit(1);
}

fn fail_ymd(msg: u8[:], day: i32, m: i32, y: i32) {
    var line: u8[>..] = [];
    format(line, msg);
    format(line, " ");
    format_int(line, day, 10, 2, '0');
    format(line, "-");
    format_int(line, m, 10, 2, '0');
    format(line, "-");
    format_int(line, y, 10, 4, '0');
    format(line, "\n");
    write_stdout(line);
    exit(1);
}

fn ymd(day: i32, m: i32, y: i32) -> date::Date {
    let d, ok = date::from_ymd(day, m, y);
    if !ok { fail("ymd"); }
    return d;
}

fn in_hol(hol: i32[:], day: i32, m: i32, y: i32) -> bool {
    let key: i32 = y * 10000 + m * 100 + day;
    var i: i64 = 0;
    while i < hol.len {
        if hol[i] == key { return true; }
        i += 1;
    }
    return false;
}

fn check_holidays(kind: i32, from: date::Date, to: date::Date, hol: i32[:], msg: u8[:]) {
    var serial = from.serial;
    while serial <= to.serial {
        let t, ok = date::from_serial(serial);
        if !ok { fail("holiday serial"); }
        let w = date::weekday(t);
        let weekend = w == date::SATURDAY || w == date::SUNDAY;
        let biz = markets_asia::is_business_day(kind, t);
        let day = date::day_of_month(t);
        let m = date::month(t);
        let y = date::year(t);
        let listed = in_hol(hol, day, m, y);
        if !weekend && !biz && !listed { fail_ymd(msg, day, m, y); }
        if listed && biz { fail_ymd(msg, day, m, y); }
        serial += 1;
    }
}

fn check_weekends(kind: i32, from: date::Date, to: date::Date, hol: i32[:]) {
    var serial = from.serial;
    var k: i64 = 0;
    while serial <= to.serial {
        let t, ok = date::from_serial(serial);
        if !ok { fail("serial"); }
        let w = date::weekday(t);
        let weekend = w == date::SATURDAY || w == date::SUNDAY;
        if markets_asia::is_business_day(kind, t) && weekend {
            let day = date::day_of_month(t);
            let m = date::month(t);
            let y = date::year(t);
            if k >= hol.len { fail_ymd("extra ib weekend", day, m, y); }
            let key: i32 = y * 10000 + m * 100 + day;
            if hol[k] != key { fail_ymd("ib weekend", day, m, y); }
            k += 1;
        }
        serial += 1;
    }
    if k != hol.len { fail("ib weekend count"); }
}

fn each_holiday(kind: i32, days: i32[:], msg: u8[:]) {
    var i: i64 = 0;
    while i < days.len {
        let key: i32 = days[i];
        let y = key / 10000;
        let m = (key / 100) % 100;
        let day = key % 100;
        if markets_asia::is_business_day(kind, ymd(day, m, y)) { fail_ymd(msg, day, m, y); }
        i += 1;
    }
}

fn open(kind: i32, day: i32, m: i32, y: i32, msg: u8[:]) {
    if !markets_asia::is_business_day(kind, ymd(day, m, y)) { fail_ymd(msg, day, m, y); }
}

