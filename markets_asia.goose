// Asia market holiday rules. A market is an i32. A day is a business
// day when is_business_day returns true. Unknown kinds are business days.
// Weekend is Saturday and Sunday. Western Easter Monday is
// easter::western(year), a day-of-year.
//
// CHINA_SSE 150: China::SseImpl, market SSE, Shanghai stock exchange
// CHINA_IB 151: China::IbImpl, market IB, China inter bank market
// HKEX 152: HongKong::HkexImpl, market HKEx, Hong Kong stock exchange
// JAPAN 153: Japan::Impl, Japan
// KR_SETTLEMENT 154: SouthKorea::SettlementImpl, market Settlement, South-Korean settlement
// KR_KRX 155: SouthKorea::KrxImpl, market KRX, South-Korea exchange
// TSEC 156: Taiwan::TsecImpl, market TSEC, Taiwan stock exchange

import date;
import easter;

