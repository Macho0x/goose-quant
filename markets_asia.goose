// SouthKorea::KrxImpl occasional closing days.
const KRX_EXTRA: i32[2] = [
    20160506, 20171002,
];

// Japan::Impl one-shot holidays.
const JAPAN_ONE: i32[8] = [
    19590410, 19890224, 19901112, 19930609, 20190430, 20190501, 20190502, 20191022,
];

fn known(kind: i32) -> bool {
    if kind == CHINA_SSE || kind == CHINA_IB || kind == HKEX { return true; }
    if kind == JAPAN || kind == KR_SETTLEMENT || kind == KR_KRX || kind == TSEC { return true; }
    return false;
}

fn is_business_day(kind: i32, d: date::Date) -> bool {
    if kind == CHINA_SSE { return china_sse(d); }
    if kind == CHINA_IB { return china_ib(d); }
    if kind == HKEX { return hong_kong(d); }
    if kind == JAPAN { return japan(d); }
    if kind == KR_SETTLEMENT { return kr_settlement(d); }
    if kind == KR_KRX { return kr_krx(d); }
    if kind == TSEC { return taiwan(d); }
    return true;
}

fn weekend(w: i32) -> bool {
    return w == date::SATURDAY || w == date::SUNDAY;
}

fn on_list(days: i32[:], y: i32, m: i32, day: i32) -> bool {
    let key: i32 = y * 10000 + m * 100 + day;
    var i: i64 = 0;
    while i < days.len {
        if days[i] == key { return true; }
        i += 1;
    }
    return false;
}

fn china_sse(d: date::Date) -> bool {
    let w = date::weekday(d);
    let day = date::day_of_month(d);
    let m = date::month(d);
    let y = date::year(d);
    if weekend(w) { return false; }
    if day == 1 && m == date::JANUARY { return false; }
    if y <= 2008 && day == 4 && m == date::APRIL { return false; }
    if y <= 2007 && day >= 1 && day <= 7 && m == date::MAY { return false; }
    if y <= 2008 && day == 9 && m == date::JUNE { return false; }
    if y <= 2008 && day == 15 && m == date::SEPTEMBER { return false; }
    if y <= 2007 && day >= 1 && day <= 7 && m == date::OCTOBER { return false; }
    if on_list(SSE_EXTRA, y, m, day) { return false; }
    return true;
}

fn china_ib(d: date::Date) -> bool {
    let day = date::day_of_month(d);
    let m = date::month(d);
    let y = date::year(d);
    if on_list(IB_WORK, y, m, day) { return true; }
    return china_sse(d);
}

fn hong_kong(d: date::Date) -> bool {
    let w = date::weekday(d);
    let day = date::day_of_month(d);
    let m = date::month(d);
    let y = date::year(d);
    let doy = date::day_of_year(d);
    let em = easter::western(y);
    if weekend(w) { return false; }
    if (day == 1 || (day == 2 && w == date::MONDAY)) && m == date::JANUARY { return false; }
    if doy == em - 3 { return false; }
    if doy == em { return false; }
    if (day == 1 || (day == 2 && w == date::MONDAY)) && m == date::MAY { return false; }
    if (day == 1 || (day == 2 && w == date::MONDAY)) && m == date::JULY { return false; }
    if (day == 1 || (day == 2 && w == date::MONDAY)) && m == date::OCTOBER { return false; }
    if day == 25 && m == date::DECEMBER { return false; }
    if day == 26 && m == date::DECEMBER { return false; }
    if on_list(HK_EXTRA, y, m, day) { return false; }
    return true;
}

fn japan(d: date::Date) -> bool {
    let w = date::weekday(d);
    let day = date::day_of_month(d);
    let m = date::month(d);
    let y = date::year(d);
    let dy = y - 2000;
    let moving = (dy as f64) * 0.242194;
    let leaps = dy / 4 + dy / 100 - dy / 400;
    let ve = (20.69115 + moving - leaps) as i32;
    let ae = (23.09 + moving - leaps) as i32;
    if weekend(w) { return false; }
    if day == 1 && m == date::JANUARY { return false; }
    if day == 2 && m == date::JANUARY { return false; }
    if day == 3 && m == date::JANUARY { return false; }
    if w == date::MONDAY && day >= 8 && day <= 14 && m == date::JANUARY && y >= 2000 { return false; }
    if (day == 15 || (day == 16 && w == date::MONDAY)) && m == date::JANUARY && y < 2000 { return false; }
    if (day == 11 || (day == 12 && w == date::MONDAY)) && m == date::FEBRUARY { return false; }
    if (day == 23 || (day == 24 && w == date::MONDAY)) && m == date::FEBRUARY && y >= 2020 { return false; }
    if (day == 23 || (day == 24 && w == date::MONDAY)) && m == date::DECEMBER && y >= 1989 && y < 2019 { return false; }
    if (day == ve || (day == ve + 1 && w == date::MONDAY)) && m == date::MARCH { return false; }
    if (day == 29 || (day == 30 && w == date::MONDAY)) && m == date::APRIL { return false; }
    if day == 3 && m == date::MAY { return false; }
    if day == 4 && m == date::MAY { return false; }
    if day == 5 && m == date::MAY { return false; }
    if day == 6 && m == date::MAY && (w == date::MONDAY || w == date::TUESDAY || w == date::WEDNESDAY) { return false; }
    if w == date::MONDAY && day >= 15 && day <= 21 && m == date::JULY && ((y >= 2003 && y < 2020) || y >= 2022) { return false; }
    if (day == 20 || (day == 21 && w == date::MONDAY)) && m == date::JULY && y >= 1996 && y < 2003 { return false; }
    if day == 23 && m == date::JULY && y == 2020 { return false; }
    if day == 22 && m == date::JULY && y == 2021 { return false; }
    if (day == 11 || (day == 12 && w == date::MONDAY)) && m == date::AUGUST && ((y >= 2016 && y < 2020) || y >= 2022) { return false; }
    if day == 10 && m == date::AUGUST && y == 2020 { return false; }
    if day == 9 && m == date::AUGUST && y == 2021 { return false; }
    if w == date::MONDAY && day >= 15 && day <= 21 && m == date::SEPTEMBER && y >= 2003 { return false; }
    if (day == 15 || (day == 16 && w == date::MONDAY)) && m == date::SEPTEMBER && y < 2003 { return false; }
    if w == date::TUESDAY && day + 1 == ae && day >= 16 && day <= 22 && m == date::SEPTEMBER && y >= 2003 { return false; }
    if (day == ae || (day == ae + 1 && w == date::MONDAY)) && m == date::SEPTEMBER { return false; }
    if w == date::MONDAY && day >= 8 && day <= 14 && m == date::OCTOBER && ((y >= 2000 && y < 2020) || y >= 2022) { return false; }
    if (day == 10 || (day == 11 && w == date::MONDAY)) && m == date::OCTOBER && y < 2000 { return false; }
    if day == 24 && m == date::JULY && y == 2020 { return false; }
    if day == 23 && m == date::JULY && y == 2021 { return false; }
    if (day == 3 || (day == 4 && w == date::MONDAY)) && m == date::NOVEMBER { return false; }
    if (day == 23 || (day == 24 && w == date::MONDAY)) && m == date::NOVEMBER { return false; }
    if day == 31 && m == date::DECEMBER { return false; }
    if on_list(JAPAN_ONE, y, m, day) { return false; }
    return true;
}

fn kr_settlement(d: date::Date) -> bool {
    let w = date::weekday(d);
    let day = date::day_of_month(d);
    let m = date::month(d);
    let y = date::year(d);
    if weekend(w) { return false; }
    if day == 1 && m == date::JANUARY { return false; }
    if day == 1 && m == date::MARCH { return false; }
    if w == date::MONDAY && (day == 2 || day == 3) && m == date::MARCH && y > 2021 { return false; }
    if day == 5 && m == date::APRIL && y <= 2005 { return false; }
    if day == 1 && m == date::MAY { return false; }
    if day == 5 && m == date::MAY { return false; }
    if w == date::MONDAY && (day == 6 || day == 7) && m == date::MAY && y > 2013 { return false; }
    if day == 6 && m == date::JUNE { return false; }
    if day == 17 && m == date::JULY && y <= 2007 { return false; }
    if day == 15 && m == date::AUGUST { return false; }
    if w == date::MONDAY && (day == 16 || day == 17) && m == date::AUGUST && y > 2020 { return false; }
    if day == 3 && m == date::OCTOBER { return false; }
    if w == date::MONDAY && (day == 4 || day == 5) && m == date::OCTOBER && y > 2020 { return false; }
    if day == 25 && m == date::DECEMBER { return false; }
    if w == date::MONDAY && (day == 26 || day == 27) && m == date::DECEMBER && y > 2022 { return false; }
    if day == 9 && m == date::OCTOBER && y >= 2013 { return false; }
    if w == date::MONDAY && (day == 10 || day == 11) && m == date::OCTOBER && y > 2020 { return false; }
    if on_list(KR_EXTRA, y, m, day) { return false; }
    return true;
}

fn kr_krx(d: date::Date) -> bool {
    if !kr_settlement(d) { return false; }
    let w = date::weekday(d);
    let day = date::day_of_month(d);
    let m = date::month(d);
    let y = date::year(d);
    if (((day == 29 || day == 30) && w == date::FRIDAY) || day == 31) && m == date::DECEMBER { return false; }
    if on_list(KRX_EXTRA, y, m, day) { return false; }
    return true;
}

fn taiwan(d: date::Date) -> bool {
    let w = date::weekday(d);
    let day = date::day_of_month(d);
    let m = date::month(d);
    let y = date::year(d);
    if weekend(w) { return false; }
    if day == 1 && m == date::JANUARY { return false; }
    if day == 28 && m == date::FEBRUARY { return false; }
    if day == 1 && m == date::MAY { return false; }
    if day == 10 && m == date::OCTOBER { return false; }
    if on_list(TW_EXTRA, y, m, day) { return false; }
    return true;
}
