// QuantLib's error function and the cumulative normal built on it.
// The rational coefficients are Sun's fdlibm erf, as QuantLib ships them.
// The inverse is Acklam's approximation, without the Halley refinement
// QuantLib leaves compiled out.

import math;

namespace normal;

const SQRT_HALF: f64 = 0.7071067811865475244008443621048490;
const EPS: f64 = 2.2204460492503131e-16;

fn abs(x: f64) -> f64 {
    if x < 0.0 { return -x; }
    return x;
}

fn erf(x: f64) -> f64 {
    if is_nan(x) { return x; }
    if is_inf(x) {
        if x > 0.0 { return 1.0; }
        return -1.0;
    }
    let ax = abs(x);
    if ax < 0.84375 {
        if ax < 3.7252902984e-09 {
            if ax < 2.2250738585072014e-308 * 16.0 {
                return 0.125 * (8.0 * x + 1.02703333676410069053 * x);
            }
            return x + 0.128379167095512586316 * x;
        }
        let z = x * x;
        let r = 0.128379167095512558561 + z * (-0.325042107247001499370 + z * (-0.0284817495755985104766 + z * (-0.00577027029648944159157 + z * -0.0000237630166566501626084)));
        let s = 1.0 + z * (0.397917223959155352819 + z * (0.0650222499887672944485 + z * (0.00508130628187576562776 + z * (0.000132494738004321644526 + z * -0.00000396022827877536812320))));
        let y = r / s;
        return x + x * y;
    }
    if ax < 1.25 {
        let s = ax - 1.0;
        let p = -0.00236211856075265944077 + s * (0.414856118683748331666 + s * (-0.372207876035701323847 + s * (0.318346619901161753674 + s * (-0.110894694282396677476 + s * (0.0354783043256182359371 + s * -0.00216637559486879084300)))));
        let q = 1.0 + s * (0.106420880400844228286 + s * (0.540397917702171048937 + s * (0.071828657441962662868 + s * (0.126171219808761642112 + s * (0.0136370839120290507362 + s * 0.0119844998467991074170)))));
        if x >= 0.0 { return 0.845062911510467529297 + p / q; }
        return -0.845062911510467529297 - p / q;
    }
    if ax >= 6.0 {
        if x >= 0.0 { return 1.0 - 1.0e-300; }
        return 1.0e-300 - 1.0;
    }
    let s = 1.0 / (ax * ax);
    var rnum = 0.0;
    var rden = 1.0;
    if ax < 2.85714285714285 {
        rnum = -0.00986494403484714822705 + s * (-0.693858572707181764372 + s * (-10.5586262253232909814 + s * (-62.3753324503260060396 + s * (-162.396669462573470355 + s * (-184.605092906711035994 + s * (-81.2874355063065934246 + s * -9.81432934416914548592))))));
        rden = 1.0 + s * (19.6512716674392571292 + s * (137.657754143519042600 + s * (434.565877475229228821 + s * (645.387271733267880336 + s * (429.008140027567833386 + s * (108.635005541779435134 + s * (6.57024977031928170135 + s * -0.0604244152148580987438)))))));
    } else {
        rnum = -0.00986494292470009928597 + s * (-0.799283237680523006574 + s * (-17.7579549177547519889 + s * (-160.636384855821916062 + s * (-637.566443368389627722 + s * (-1025.09513161107724954 + s * -483.519191608651397019)))));
        rden = 1.0 + s * (30.3380607434824582924 + s * (325.792512996573918826 + s * (1536.72958608443695994 + s * (3199.85821950859553908 + s * (2553.05040643316442583 + s * (474.528541206955367215 + s * -22.4409524465858183362))))));
    }
    let tail = exp(-ax * ax - 0.5625 + rnum / rden);
    if x >= 0.0 { return 1.0 - tail / ax; }
    return tail / ax - 1.0;
}

fn pdf(z: f64) -> f64 {
    return exp(-0.5 * z * z) / sqrt(2.0 * PI);
}

fn cdf(z: f64) -> f64 {
    var result = 0.5 * (1.0 + erf(z * SQRT_HALF));
    if result > 1.0e-8 { return result; }
    let zsqr = z * z;
    if zsqr == 0.0 { return result; }
    var sum = 1.0;
    var i = 1.0;
    var g = 1.0;
    var a = 1.0e300;
    var n = 0;
    while n < 64 {
        let last = a;
        let x = (4.0 * i - 3.0) / zsqr;
        let y = x * ((4.0 * i - 1.0) / zsqr);
        a = g * (x - y);
        sum -= a;
        g *= y;
        i += 1.0;
        if a < 0.0 { a = -a; }
        var band = sum;
        if band < 0.0 { band = -band; }
        if last <= a || a < band * EPS { break; }
        n += 1;
    }
    return -pdf(z) / z * sum;
}

fn inv_cdf(p: f64) -> f64, bool {
    if p <= 0.0 || p >= 1.0 { return 0.0, false; }
    if p < 0.02425 || p > 0.97575 { return inv_tail(p), true; }
    let z = p - 0.5;
    let r = z * z;
    let num = (((((-39.69683028665376 * r + 220.9460984245205) * r + -275.9285104469687) * r + 138.3577518672690) * r + -30.66479806614716) * r + 2.506628277459239) * z;
    let den = (((((-54.47609879822406 * r + 161.5858368580409) * r + -155.6989798598866) * r + 66.80131188771972) * r + -13.28068155288572) * r + 1.0);
    return num / den, true;
}

fn inv_tail(p: f64) -> f64 {
    if p < 0.02425 {
        let z = sqrt(-2.0 * log(p));
        let num = (((((-0.007784894002430293 * z + -0.3223964580411365) * z + -2.400758277161838) * z + -2.549732539343734) * z + 4.374664141464968) * z + 2.938163982698783);
        let den = ((((0.007784695709041462 * z + 0.3224671290700398) * z + 2.445134137142996) * z + 3.754408661907416) * z + 1.0);
        return num / den;
    }
    let z = sqrt(-2.0 * log(1.0 - p));
    let num = (((((-0.007784894002430293 * z + -0.3223964580411365) * z + -2.400758277161838) * z + -2.549732539343734) * z + 4.374664141464968) * z + 2.938163982698783);
    let den = ((((0.007784695709041462 * z + 0.3224671290700398) * z + 2.445134137142996) * z + 3.754408661907416) * z + 1.0);
    return -(num / den);
}
